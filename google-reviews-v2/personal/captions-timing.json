[{"text": "היי, כאן בניה.", "t": [0.092, 0.508, 0.646], "t0": 0.032, "t1": 1.002}, {"text": "ראיתם עכשיו בקצרה איך זה עובד?", "t": [1.062, 1.215, 1.4, 1.785, 1.969, 2.031], "t0": 1.002, "t1": 2.278}, {"text": "רציתי להגיד עוד כמה מילים.", "t": [2.338, 2.554, 2.738, 2.815, 2.985], "t0": 2.278, "t1": 3.202}, {"text": "כשאני אחפש רופא שיניים,", "t": [3.262, 3.477, 3.677, 3.831], "t0": 3.202, "t1": 4.094}, {"text": "אני אכנס לגוגל ובודק מי נמצא באזור שלי,", "t": [4.154, 4.215, 4.431, 4.708, 4.969, 5.046, 5.277, 5.6], "t0": 4.094, "t1": 5.802}, {"text": "למי שיש יותר ביקורות טובות.", "t": [5.862, 5.985, 6.123, 6.323, 6.646], "t0": 5.802, "t1": 6.971}, {"text": "אליו אני מתקשר.", "t": [7.031, 7.154, 7.246], "t0": 6.971, "t1": 7.74}, {"text": "אני לא לבד.", "t": [7.8, 7.862, 7.938], "t0": 7.74, "t1": 8.325}, {"text": "לפי [Press Ganey], חברת המחקר הגדולה בארצות הברית", "t": [8.385, 8.585, 8.769, 8.938, 9.138, 9.415, 9.646, 9.908], "t0": 8.325, "t1": 10.063}, {"text": "לחוויית מטופלים,", "t": [10.123, 10.354], "t0": 10.063, "t1": 10.878}, {"text": "ביקורות באינטרנט", "t": [10.938, 11.185], "t0": 10.878, "t1": 11.509}, {"text": "הן [השיקול מספר אחת]", "t": [11.569, 11.677, 12.0, 12.308], "t0": 11.509, "t1": 12.494}, {"text": "בבחירת רופא.", "t": [12.554, 12.923], "t0": 12.494, "t1": 13.232}, {"text": "עוד לפני המלצה של רופא אחר.", "t": [13.292, 13.477, 13.646, 13.923, 13.985, 14.169], "t0": 13.232, "t1": 14.417}, {"text": "ושוב ושוב אני רואה", "t": [14.477, 14.754, 15.092, 15.138], "t0": 14.417, "t1": 15.232}, {"text": "מרפאות טובות,", "t": [15.292, 15.8], "t0": 15.232, "t1": 16.155}, {"text": "שמגיעות אליהן עשרות", "t": [16.215, 16.523, 16.769], "t0": 16.155, "t1": 17.094}, {"text": "ואפילו מאות מטופלים כל חודש,", "t": [17.154, 17.446, 17.692, 18.031, 18.169], "t0": 17.094, "t1": 18.478}, {"text": "ובגוגל יש להן", "t": [18.538, 18.877, 18.969], "t0": 18.478, "t1": 19.155}, {"text": "רק [כמה עשרות ביקורות],", "t": [19.215, 19.554, 19.862, 20.123], "t0": 19.155, "t1": 20.463}, {"text": "חלקן מלפני חודשיים", "t": [20.523, 20.769, 21.015], "t0": 20.463, "t1": 21.278}, {"text": "ואפילו חצי שנה.", "t": [21.338, 21.585, 21.8], "t0": 21.278, "t1": 22.109}, {"text": "אז בניתי [מערכת פשוטה],", "t": [22.169, 22.246, 22.415, 22.677], "t0": 22.109, "t1": 23.202}, {"text": "שמעכשיו אחרי כל ביקור,", "t": [23.262, 23.954, 24.154, 24.277], "t0": 23.202, "t1": 24.617}, {"text": "המטופל שלכם מקבל", "t": [24.677, 25.0, 25.262], "t0": 24.617, "t1": 25.448}, {"text": "הודעה קצרה [בוואטסאפ]", "t": [25.508, 25.754, 26.015], "t0": 25.448, "t1": 26.494}, {"text": "מהמספר של המרפאה,", "t": [26.554, 26.892, 26.954], "t0": 26.494, "t1": 27.586}, {"text": "והיא שואלת איך היה.", "t": [27.646, 27.754, 27.923, 28.092], "t0": 27.586, "t1": 28.355}, {"text": "מי שיצא מרוצה,", "t": [28.415, 28.477, 28.662], "t0": 28.355, "t1": 29.094}, {"text": "מגיע [בלחיצה אחת]", "t": [29.154, 29.385, 29.769], "t0": 29.094, "t1": 30.248}, {"text": "לכתוב ביקורת בגוגל.", "t": [30.308, 30.554, 30.831], "t0": 30.248, "t1": 31.14}, {"text": "ככה כל חודש", "t": [31.2, 31.508, 31.677], "t0": 31.14, "t1": 31.832}, {"text": "נכנסות [ביקורות חדשות],", "t": [31.892, 32.154, 32.4], "t0": 31.832, "t1": 32.878}, {"text": "המרפאה עולה בחיפושים,", "t": [32.938, 33.277, 33.385], "t0": 32.878, "t1": 33.74}, {"text": "ויותר אנשים מתקשרים.", "t": [33.8, 33.985, 34.169], "t0": 33.74, "t1": 34.678}, {"text": "אם משהו לא היה בסדר,", "t": [34.738, 34.862, 35.062, 35.185, 35.308], "t0": 34.678, "t1": 35.709}, {"text": "אתם שומעים על זה [ראשונים], ישר למייל.", "t": [35.769, 35.908, 36.108, 36.169, 36.231, 36.754, 36.923], "t0": 35.709, "t1": 37.263}, {"text": "אפשר להרים אליו טלפון", "t": [37.323, 37.492, 37.662, 37.8], "t0": 37.263, "t1": 38.048}, {"text": "ולסדר זה לפני שהמטופל הולך לרופא אחר.", "t": [38.108, 38.446, 38.6, 38.8, 39.138, 39.338, 39.585], "t0": 38.048, "t1": 40.017}, {"text": "גם המטופלים מרגישים את ההבדל.", "t": [40.077, 40.185, 40.492, 40.785, 40.846], "t0": 40.017, "t1": 41.278}, {"text": "שאלו אותם, הקשיבו להם,", "t": [41.338, 41.615, 41.846, 42.123], "t0": 41.278, "t1": 42.54}, {"text": "[אכפת מהם].", "t": [42.6, 42.892], "t0": 42.54, "t1": 43.171}, {"text": "ואתם [לא צריכים לעשות כלום].", "t": [43.231, 43.354, 43.446, 43.6, 43.831], "t0": 43.171, "t1": 44.186}, {"text": "אני מחבר ומנהל את הכול,", "t": [44.246, 44.354, 44.6, 44.815, 44.908], "t0": 44.186, "t1": 45.155}, {"text": "והמערכת עובדת לבד", "t": [45.215, 45.492, 45.738], "t0": 45.155, "t1": 45.909}, {"text": "מאחורי הקלעים.", "t": [45.969, 46.185], "t0": 45.909, "t1": 46.602}, {"text": "אם זה נשמע לכם רלוונטי,", "t": [46.662, 46.738, 46.8, 46.969, 47.108], "t0": 46.602, "t1": 47.463}, {"text": "תענו לי פה [בוואטסאפ],", "t": [47.523, 47.708, 47.815, 47.908], "t0": 47.463, "t1": 48.402}, {"text": "או [תתקשרו].", "t": [48.462, 48.523], "t0": 48.402, "t1": 49.078}, {"text": "נקבע שיחה של [רבע שעה],", "t": [49.138, 49.338, 49.538, 49.631, 49.831], "t0": 49.078, "t1": 50.063}, {"text": "שבה אסביר לכם", "t": [50.123, 50.308, 50.569], "t0": 50.063, "t1": 50.755}, {"text": "על איך זה יעבוד אצלכם,", "t": [50.815, 50.908, 51.046, 51.138, 51.338], "t0": 50.755, "t1": 51.955}, {"text": "ונענה על כל השאלות שיהיו.", "t": [52.015, 52.151, 52.262, 52.369, 52.646], "t0": 51.955, "t1": 52.95}]